# =============================================================================
# .env.example  —  Copia este archivo como ".env" y rellena los valores reales
# =============================================================================

# ── Base de datos 1: índice de Dropbox ───────────────────────────────────────
# Tabla: dropbox_items  (pasos 1 y 3)
DB_URL=postgresql+psycopg2://USUARIO:CONTRASEÑA@HOST:5433/dropbox_index

# Alternativamente, puedes usar variables separadas (usadas en step1_dropbox):
# DB_NAME=dropbox_index
# DB_HOST=192.168.1.100
# DB_PORT=5433
# DB_USER=usuario
# DB_PASS=contraseña

# ── Base de datos 2: registro de audios/llamadas ──────────────────────────────
# Tablas: mendoza_box.audios_descargados, RH.usuarios  (paso 0)
AUDIOS_DB_URL=postgresql+psycopg2://USUARIO:CONTRASEÑA@HOST:5432/calls_db

# ── Autenticación Dropbox (microservicio de tokens) ───────────────────────────
TOKEN_SERVICE_URL=https://accesstokendropbox-223080314602.us-central1.run.app
API_SECRET_KEY=TU_SECRET_KEY_AQUI

# ── Rutas de archivos de audio ────────────────────────────────────────────────
# Ruta en el HOST donde están los audios (se monta como volumen en Docker)
AUDIOS_HOST_DIR=/var/www/html/FILES/descarga_audios

# Prefijo de la ruta del host que se sustituye por AUDIOS_MOUNT dentro del contenedor
# Ejemplo: /var/www/html/FILES/descarga_audios/CLIENTE/audio.mp3
#          → /audios/CLIENTE/audio.mp3
AUDIOS_HOST_PREFIX=/var/www/html/FILES/descarga_audios
AUDIOS_MOUNT=/audios

# ── Configuración del pipeline ────────────────────────────────────────────────
# Directorio de salida dentro del contenedor (no cambiar salvo que ajustes el volumen)
OUTPUT_DIR=/app/output

# Límite de audios a procesar por ejecución en el paso 4 (subida a Dropbox)
LIMIT=50

# Umbral para descartar carpetas muy repetidas (paso 1)
REPEAT_THRESHOLD=3
